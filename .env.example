# ==============================================================================
# Intelligent Payment & Order Platform - Environment Configuration Example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_min_entropy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relational Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=intelligent_payment_db

# Microservice Specific Databases (PostgreSQL)
USER_DB_NAME=user_service_db
PRODUCT_DB_NAME=product_service_db
ORDER_DB_NAME=order_service_db
PAYMENT_DB_NAME=payment_service_db

# Database Connection URLs (Async format)
USER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/user_service_db
PRODUCT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/product_service_db
ORDER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/order_service_db
PAYMENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/payment_service_db

# Redis (Caching & Pub/Sub Messaging)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# NoSQL Database (MongoDB for Fraud & Notification logs)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=intelligent_payment_nosql
MONGODB_URL=mongodb://mongodb:27017/intelligent_payment_nosql

# Internal Service URLs (For Gateway & Inter-service Communication)
API_GATEWAY_PORT=8000
USER_SERVICE_URL=http://user-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003
FRAUD_SERVICE_URL=http://fraud-service:8004
PAYMENT_SERVICE_URL=http://payment-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006

# Third-Party Payment Integration (Stripe Sandbox)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_sandbox
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
USE_MOCK_PAYMENT_PROVIDER=true

# Azure Cloud Integration (Optional / Fallback to local when not configured)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEYVAULT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TABLES_ENDPOINT=
USE_AZURE_INTEGRATION=false

# Notification Providers
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@intelligentpayment.com
